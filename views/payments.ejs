<!DOCTYPE html>
<html lang="en">
<%- include("partials/header") %>

    <body>
        <%- include('partials/sidebar', { activePage: 'payments' }) %>

            <main class="content flex-grow-1 p-4">
                <h1>Payments</h1>
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Payment ID</th>
                            <th>Student ID</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% payments.forEach(payment=> { %>
                            <tr>
                                <td>
                                    <%= payment.id %>
                                </td>
                                <td>
                                    <%= payment.studentId || '-' %>
                                </td>
                                <td>
                                    <%= payment.amount || '-' %>
                                </td>
                                <td>
                                    <%= payment.date || '-' %>
                                </td>
                                <td>
                                    <%= payment.status || '-' %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </main>
            <%- include("partials/footer") %>
    </body>

</html>