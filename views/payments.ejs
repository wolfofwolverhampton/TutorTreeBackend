<!DOCTYPE html>
<html lang="en">
<%- include("partials/header", {pageTitle: "Payment Transactions" }) %>

    <body>
        <%- include('partials/sidebar', { activePage: 'payments' }) %>

            <main class="content flex-grow-1 p-4">
                <h1 class="mb-4">Payments</h1>
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-hover table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Transaction ID</th>
                                <th>Order Name</th>
                                <th>Student</th>
                                <th>Teacher</th>
                                <th>Subscription ID</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% payments.forEach(payment=> { %>
                                <tr>
                                    <td>
                                        <%= payment.id || '-' %>
                                    </td>
                                    <td>
                                        <%= payment.purchaseOrderName || '-' %>
                                    </td>
                                    <td>
                                        <strong>
                                            <%= payment.studentName || 'Unknown Student' %>
                                        </strong><br>
                                        <small class="text-muted">
                                            <%= payment.studentUid || '-' %>
                                        </small>
                                    </td>
                                    <td>
                                        <strong>
                                            <%= payment.teacherName || 'Unknown Teacher' %>
                                        </strong><br>
                                        <small class="text-muted">
                                            <%= payment.teacherUid || '-' %>
                                        </small>
                                    </td>
                                    <td>
                                        <%= payment.subscriptionId || '-' %>
                                    </td>
                                    <td>Rs. <%= payment.amount || '0' %>
                                    </td>
                                    <td>
                                        <%= payment.timestamp ? new Date(payment.timestamp).toLocaleDateString('en-IN',
                                            { day: '2-digit' , month: 'short' , year: 'numeric' }) : '-' %>
                                    </td>
                                    <td>
                                        <%= payment.status || '-' %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <%- include("partials/pagination.ejs") %>
                </div>
            </main>

            <%- include("partials/footer") %>
    </body>

</html>