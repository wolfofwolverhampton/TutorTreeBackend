<!DOCTYPE html>
<html lang="en">
<%- include("partials/header", { pageTitle: "Chat History" }) %>

<style>
  .chat-box {
    max-height: 70vh;
    overflow-y: auto;
    padding: 1rem;
    background-color: #f8f9fa;
    border-radius: 8px;
    border: 1px solid #dee2e6;
  }
  .chat-message {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    max-width: 75%;
  }
  .chat-message.left {
    align-self: flex-start;
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 12px 12px 12px 0;
    padding: 0.75rem;
  }
  .chat-message.right {
    align-self: flex-end;
    background-color: #d1e7dd;
    border: 1px solid #badbcc;
    border-radius: 12px 12px 0 12px;
    padding: 0.75rem;
  }
  .chat-timestamp {
    font-size: 0.75rem;
    color: #6c757d;
    margin-top: 0.25rem;
    text-align: right;
  }
</style>

<body>
  <%- include('partials/sidebar', { activePage: 'chats' }) %>

  <main class="content p-4">
    <h1 class="mb-4">Chat History: <%= roomId %></h1>

    <div class="chat-box d-flex flex-column">
      <% if (messages.length === 0) { %>
        <div class="text-muted">No messages yet.</div>
      <% } else { %>
        <% messages.forEach((msg) => { 
          const isSender = msg.senderId === messages[0].senderId;
        %>
          <div class="chat-message <%= isSender ? 'left' : 'right' %>">
            <div><%= msg.message %></div>
            <div class="chat-timestamp"><%= new Date(msg.timestamp).toLocaleString('en-IN') %></div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>

  <%- include("partials/footer") %>
</body>
</html>